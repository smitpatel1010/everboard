{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR/scripts/agent-guard.sh\" ] && exec \"$CLAUDE_PROJECT_DIR/scripts/agent-guard.sh\" claude-code; exit 0",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
